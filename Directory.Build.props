<Project>

  <!-- Ortak özellikler: tüm projeler için tek yer. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1051: ViewModelBase'te protected alan (Logger/Dispatcher) kasıtlı
         CA1716: IEmulatorBackendFactory.Get / ILoggingService.Error adları okunabilirlik için seçildi
         CA1001: CancellationTokenSource alanları ViewModel yaşam döngüsünde kasıtlı
         CA1822: LegalNote gibi üyeler XAML binding için örnek üye kalmalı -->
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1031;CA1051;CA1716;CA1001;CA1822</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Assembly metadata">
    <Product>GameShelf</Product>
    <Company>GameShelf</Company>
    <Copyright>Offline launcher for legally owned game dumps. No ROM/BIOS distribution.</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
