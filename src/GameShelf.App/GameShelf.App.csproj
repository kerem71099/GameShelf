<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- FolderBrowserDialog (System.Windows.Forms) için gerekiyor -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GameShelf.App</RootNamespace>
    <AssemblyName>GameShelf</AssemblyName>

    <!-- RID yalnızca publish sırasında verilir (scripts/publish-exe.bat -r win-x64).
         Burada "RuntimeIdentifiers" kullanmak, build/run'un RID paketi indirmesini
         gerektirmez -> NETSDK1047 gibi hataların önüne geçer. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- Tek EXE ayarları (yalnızca publish sırasında anlamlı) -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SQLite native (e_sqlite3.dll) tek dosyadan açılabilsin -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameShelf.Application\GameShelf.Application.csproj" />
    <ProjectReference Include="..\GameShelf.Infrastructure\GameShelf.Infrastructure.csproj" />
  </ItemGroup>

</Project>
