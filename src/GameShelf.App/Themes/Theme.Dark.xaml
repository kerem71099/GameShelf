<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shelf · Dark (mürekkep) — sıcak nötr gri + Ember vurgusu -->

    <!-- Yüzeyler -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#141517" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1C1E21" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#24272B" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#101113" />

    <!-- Kenarlıklar -->
    <SolidColorBrush x:Key="Brush.Border" Color="#2E3237" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3D4248" />

    <!-- Metin -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#EDEAE4" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B4AFA6" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#7C7772" />

    <!-- Vurgu (Ember) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#D98A5F" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#E39C74" />
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="#17140F" />

    <!-- Durum -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#E06C5A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D8A657" />
    <SolidColorBrush x:Key="Brush.Success" Color="#7FA86B" />

    <!-- Etkileşim -->
    <SolidColorBrush x:Key="Brush.Hover" Color="#FFFFFF" Opacity="0.06" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#D98A5F" Opacity="0.18" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#000000" Opacity="0.50" />

    <!-- Platform kimlikleri (yalnızca chip ve ince kenar çizgisi) -->
    <SolidColorBrush x:Key="Brush.PlatformPs1" Color="#6E8B9E" />
    <SolidColorBrush x:Key="Brush.PlatformPs2" Color="#7C88CC" />
    <SolidColorBrush x:Key="Brush.PlatformPs3" Color="#A183B4" />
    <SolidColorBrush x:Key="Brush.PlatformPs4" Color="#6A6F76" />
    <SolidColorBrush x:Key="Brush.PlatformPs5" Color="#6A6F76" />
    <SolidColorBrush x:Key="Brush.PlatformUnknown" Color="#6A6F76" />

</ResourceDictionary>
