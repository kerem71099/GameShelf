<UserControl x:Class="GameShelf.App.Views.DownloadsView"
             x:Name="DownloadsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameShelf.Application.ViewModels;assembly=GameShelf.Application"
             xmlns:converters="clr-namespace:GameShelf.App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource Thickness.XL}" MaxWidth="920" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="İndirme Merkezi" Style="{StaticResource TextDisplay}" />

            <TextBlock Grid.Row="1" Text="{Binding Note}" Style="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,8,0,20" />

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DownloadRow}">
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Item.Category}" Style="{StaticResource TextOverline}" />
                                    <TextBlock Text="{Binding Item.Title}" Style="{StaticResource TextTitle}"
                                               Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding Item.Description}" Style="{StaticResource TextMuted}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <ProgressBar Margin="0,8,0,0" Style="{StaticResource ProgressBarBase}"
                                                 Minimum="0" Maximum="1" Height="4"
                                                 Value="{Binding Progress}"
                                                 Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center"
                                            Margin="20,0,0,0">
                                    <Button Content="İndir ve kur" Style="{StaticResource ButtonPrimary}" MinWidth="150"
                                            Command="{Binding DataContext.DownloadCommand, ElementName=DownloadsRoot}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Resmî sayfa" Margin="0,8,0,0" Style="{StaticResource ButtonGhost}"
                                            MinWidth="150"
                                            Command="{Binding DataContext.OpenPageCommand, ElementName=DownloadsRoot}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Klasörü aç" Margin="0,8,0,0" Style="{StaticResource ButtonGhost}"
                                            MinWidth="150"
                                            Command="{Binding DataContext.OpenFolderCommand, ElementName=DownloadsRoot}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
