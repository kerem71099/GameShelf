<UserControl x:Class="GameShelf.App.Views.GameDetailsView"
             x:Name="DetailsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameShelf.Application.ViewModels;assembly=GameShelf.Application"
             xmlns:converters="clr-namespace:GameShelf.App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:PlatformToBrushConverter x:Key="PlatformToBrush" />
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringEmptyToVisibility" />
        <converters:StringNotNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LaunchCommand}" />
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource Space.XL}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================== üst bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="‹ Kütüphane" Style="{StaticResource ButtonGhost}" Command="{Binding BackCommand}" />
                <TextBlock Text="{Binding PlatformShort}" Style="{StaticResource TextOverline}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============================================ kapak -->
                <StackPanel>
                    <Border Width="240" Height="320" CornerRadius="{StaticResource Radius.Card}"
                            Background="{DynamicResource Brush.SurfaceSunken}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="{StaticResource Thickness.Hairline}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                                   Visibility="{Binding CoverPath, Converter={StaticResource StringNotEmptyToVisibility}}" />
                            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="40" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Visibility="{Binding CoverPath, Converter={StaticResource StringEmptyToVisibility}}" />
                        </Grid>
                    </Border>
                    <Button Content="Kapak seç (yerel dosya)" Margin="0,12,0,0" Style="{StaticResource ButtonSecondary}"
                            Command="{Binding PickCoverCommand}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- ============================================ bilgiler -->
                <StackPanel Grid.Column="1" Margin="32,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxBase}"
                                 FontSize="{StaticResource FontSize.DisplaySmall}"
                                 Height="{StaticResource ControlHeightLarge}" />
                        <Button Grid.Column="1" Content="★" Margin="12,0,0,0" Style="{StaticResource ButtonGhost}"
                                FontSize="20" Foreground="{DynamicResource Brush.Accent}"
                                Command="{Binding ToggleFavoriteCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border Style="{StaticResource PlatformChip}">
                            <TextBlock Text="{Binding PlatformId}" FontSize="{StaticResource FontSize.Overline}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding PlatformShort, Converter={StaticResource PlatformToBrush}}" />
                        </Border>
                        <ComboBox Margin="12,0,0,0" Width="180" Style="{StaticResource ComboBoxBase}"
                                  ItemsSource="{Binding Platforms}"
                                  SelectedItem="{Binding PlatformId}" />
                        <TextBox Margin="12,0,0,0" Width="80" Style="{StaticResource TextBoxBase}"
                                 Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Region" Style="{StaticResource TextMuted}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="▶ Başlat (Enter)" Style="{StaticResource ButtonLaunch}"
                                Command="{Binding LaunchCommand}" />
                        <Button Content="Kaydet" Margin="12,0,0,0" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding SaveCommand}" />
                        <Button Content="Klasörde göster" Margin="12,0,0,0" Style="{StaticResource ButtonGhost}"
                                Command="{Binding OpenFolderCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource TextCaption}" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding PlayTimeText}" Style="{StaticResource TextCaption}" />
                    <TextBlock Text="{Binding FilePath}" Style="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource Brush.SurfaceSunken}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <TextBlock Text="{Binding CommandPreview}" Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap" FontFamily="Consolas" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================== notlar + override -->
            <Grid Grid.Row="2" Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="NOTLAR" Style="{StaticResource SectionHeader}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxBase}"
                             Height="120" Padding="10" VerticalContentAlignment="Top"
                             AcceptsReturn="True" TextWrapping="Wrap" />
                    <TextBlock Text="Notlar yerelde saklanır, hiçbir yere gönderilmez." Style="{StaticResource TextMuted}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="BU OYUN İÇİN OVERRIDE" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="Tam ekran" Style="{StaticResource TextCaption}" />
                    <ComboBox Margin="0,4,0,12" Style="{StaticResource ComboBoxBase}"
                              SelectedItem="{Binding FullscreenMode}">
                        <x:Static Member="vm:FullscreenMode.Default" />
                        <x:Static Member="vm:FullscreenMode.On" />
                        <x:Static Member="vm:FullscreenMode.Off" />
                    </ComboBox>

                    <TextBlock Text="Ek argümanlar ({extra})" Style="{StaticResource TextCaption}" />
                    <TextBox Margin="0,4,0,12" Style="{StaticResource TextBoxBase}"
                             Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Argüman şablonu (boşsa emülatör varsayılanı)" Style="{StaticResource TextCaption}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource TextBoxBase}"
                                 Text="{Binding ArgumentTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" />
                        <Button Grid.Column="1" Content="Sıfırla" Margin="8,0,0,0" Style="{StaticResource ButtonGhost}"
                                Command="{Binding ResetTemplateCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextCaption}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextCaption}"
                               Foreground="{DynamicResource Brush.Danger}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
