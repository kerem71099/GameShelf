<UserControl x:Class="GameShelf.App.Views.LibraryView"
             x:Name="LibraryRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameShelf.Application.ViewModels;assembly=GameShelf.Application"
             xmlns:converters="clr-namespace:GameShelf.App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- ============================================= kart görünümü -->
        <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type vm:GameItemViewModel}">
            <Border Width="{StaticResource CardWidth}" Style="{StaticResource Card}">
                <StackPanel Margin="{StaticResource Thickness.S}">
                    <Border Height="{StaticResource CardCoverHeight}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Background="{DynamicResource Brush.SurfaceSunken}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding CoverPath}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Initials}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="34" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource TextBodyStrong}"
                                   MaxHeight="40" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="★" Padding="4,0" MinWidth="28"
                                Style="{StaticResource ButtonGhost}"
                                Foreground="{DynamicResource Brush.Accent}"
                                Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=LibraryRoot}"
                                CommandParameter="{Binding}" />
                    </Grid>

                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextMuted}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource TextMuted}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============================================ liste görünümü -->
        <DataTemplate x:Key="GameRowTemplate" DataType="{x:Type vm:GameItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="★" Padding="4,0" MinWidth="28"
                        Style="{StaticResource ButtonGhost}"
                        Foreground="{DynamicResource Brush.Accent}"
                        Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=LibraryRoot}"
                        CommandParameter="{Binding}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TextBodyStrong}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding PlatformShort}" Style="{StaticResource TextCaption}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding LastPlayedText}" Style="{StaticResource TextCaption}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding PlayTimeText}" Style="{StaticResource TextCaption}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Thickness.XL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================== başlık + araçlar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Kütüphane" Style="{StaticResource TextDisplay}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="260" Style="{StaticResource TextBoxBase}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ToggleButton Content="★ Favori" Margin="8,0,0,0" Style="{StaticResource ToggleChip}"
                              IsChecked="{Binding FavoritesOnly}" />
                <ComboBox Width="176" Margin="8,0,0,0" Style="{StaticResource ComboBoxBase}"
                          ItemsSource="{Binding SortOptions}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SortBy}"
                          DisplayMemberPath="Label" />
                <Button Content="{Binding ViewModeText}" Margin="8,0,0,0" Style="{StaticResource ButtonSecondary}"
                        Command="{Binding ToggleViewModeCommand}" />
                <Button Content="Yeniden tara" Margin="8,0,0,0" Style="{StaticResource ButtonSecondary}"
                        Command="{Binding RescanCommand}" />
            </StackPanel>
        </Grid>

        <!-- ============================================== platform filtresi -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding PlatformFilters}" Margin="0,16,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlatformFilterItem}">
                    <Button Margin="0,0,8,0" Style="{StaticResource ButtonGhost}"
                            Command="{Binding DataContext.SelectPlatformCommand, ElementName=LibraryRoot}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="{Binding Count, StringFormat=' {0}'}"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============================================== içerik -->
        <Grid Grid.Row="2">
            <!-- Grid -->
            <ListBox ItemsSource="{Binding Games}"
                     SelectedItem="{Binding SelectedGame}"
                     Style="{StaticResource PlainListBox}"
                     ItemTemplate="{StaticResource GameCardTemplate}"
                     ItemContainerStyle="{StaticResource CardListBoxItem}"
                     Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.InputBindings>
                    <KeyBinding Key="Enter"
                                Command="{Binding DataContext.LaunchCommand, ElementName=LibraryRoot}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding DataContext.LaunchCommand, ElementName=LibraryRoot}"
                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </ListBox.InputBindings>
            </ListBox>

            <!-- Liste -->
            <ListBox ItemsSource="{Binding Games}"
                     SelectedItem="{Binding SelectedGame}"
                     Style="{StaticResource PlainListBox}"
                     ItemTemplate="{StaticResource GameRowTemplate}"
                     ItemContainerStyle="{StaticResource RowListBoxItem}"
                     Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVisibility}}">
                <ListBox.InputBindings>
                    <KeyBinding Key="Enter"
                                Command="{Binding DataContext.LaunchCommand, ElementName=LibraryRoot}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding DataContext.LaunchCommand, ElementName=LibraryRoot}"
                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </ListBox.InputBindings>
            </ListBox>

            <!-- Boş durum -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VisibleCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Kütüphane boş" Style="{StaticResource TextTitle}" HorizontalAlignment="Center" />
                <TextBlock Text="Ayarlar → Kütüphane klasörleri bölümünden kendi oyun klasörünü ekle, sonra buradan yeniden tara."
                           Style="{StaticResource TextCaption}" TextAlignment="Center" MaxWidth="420"
                           TextWrapping="Wrap" Margin="0,8,0,16" />
                <Button Content="Ayarları aç (Ctrl+,)" Style="{StaticResource ButtonSecondary}"
                        HorizontalAlignment="Center"
                        Command="{Binding DataContext.OpenSettingsCommand, ElementName=LibraryRoot}" />
            </StackPanel>
        </Grid>

        <!-- ============================================== durum çubuğu -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <ProgressBar Style="{StaticResource ProgressBarBase}"
                             Value="{Binding ScanProgress}" Maximum="1"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextCaption}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextCaption}"
                           Foreground="{DynamicResource Brush.Danger}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding VisibleCount, StringFormat='{}{0} oyun'}"
                           Style="{StaticResource TextMuted}" VerticalAlignment="Center" />
                <Button Content="Detay" Margin="12,0,0,0" Style="{StaticResource ButtonSecondary}"
                        Command="{Binding ShowDetailsSelectedCommand}" />
                <Button Content="Başlat" Margin="8,0,0,0" Style="{StaticResource ButtonPrimary}"
                        Command="{Binding LaunchSelectedCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
