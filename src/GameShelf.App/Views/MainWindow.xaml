<Window x:Class="GameShelf.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameShelf.Application.ViewModels;assembly=GameShelf.Application"
        xmlns:views="clr-namespace:GameShelf.App.Views"
        Title="GameShelf — Offline PlayStation Library"
        Width="1280" Height="820" MinWidth="960" MinHeight="620"
        FontFamily="{StaticResource Font.Body}"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding Library.ShowDetailsSelectedCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}" />
        <KeyBinding Key="F5" Command="{Binding Library.RescanCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding Library.SetGridCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding Library.SetListCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource RailWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================ sol gezinme -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="24,28,24,16">
                    <TextBlock Text="GameShelf" Style="{StaticResource TextDisplay}" FontSize="20" />
                    <TextBlock Text="Offline · yalnızca yerel kütüphane" Style="{StaticResource TextMuted}" Margin="0,4,0,0" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Style="{StaticResource PlainListBox}"
                         Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="16,10">
                                <TextBlock Text="{Binding Glyph}" Width="26"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="{StaticResource FontSize.Body}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowListBoxItem}">
                            <Setter Property="Height" Value="40" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="16,8,16,20">
                    <Button Content="Tema değiştir (Ctrl+T)"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding ToggleThemeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ içerik -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Content="{Binding CurrentView}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
                    <views:LibraryView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:GameDetailsViewModel}">
                    <views:GameDetailsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                    <views:SettingsView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
                    <views:ToolsView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
