<UserControl x:Class="GameShelf.App.Views.SettingsView"
             x:Name="SettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameShelf.Application.ViewModels;assembly=GameShelf.Application"
             xmlns:entities="clr-namespace:GameShelf.Domain.Entities;assembly=GameShelf.Domain">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource Thickness.XL}" MaxWidth="920" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Ayarlar" Style="{StaticResource TextDisplay}" />

            <!-- ===================================== kütüphane klasörleri -->
            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="KÜTÜPHANE KLASÖRLERİ" Style="{StaticResource TextOverline}" />
                    <TextBlock Text="Yalnızca kendi yasal olarak edindiğin oyun dump'larının bulunduğu klasörleri ekle."
                               Style="{StaticResource TextCaption}" Margin="0,4,0,12" />

                    <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                             Style="{StaticResource PlainListBox}"
                             ItemContainerStyle="{StaticResource RowListBoxItem}"
                             MinHeight="60" MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type entities:LibraryFolder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource TextBody}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Kaldır" Style="{StaticResource ButtonGhost}"
                                            Command="{Binding DataContext.RemoveFolderCommand, ElementName=SettingsRoot}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="+ Oyun klasörü ekle" Margin="0,12,0,0" Style="{StaticResource ButtonSecondary}"
                            Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- ============================================ emülatörler -->
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="EMÜLATÖRLER" Style="{StaticResource TextOverline}" />
                    <TextBlock Text="GameShelf emülatör dağıtmaz; kendi kurulumunun exe yolunu ver."
                               Style="{StaticResource TextCaption}" Margin="0,4,0,12" />

                    <ItemsControl ItemsSource="{Binding Emulators}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EmulatorSettingItem}">
                                <Border Padding="16" Margin="0,0,0,12"
                                        Background="{DynamicResource Brush.SurfaceSunken}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="{StaticResource Thickness.Hairline}"
                                        CornerRadius="{StaticResource Radius.Control}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PlatformName}" Style="{StaticResource TextTitle}" />
                                            <TextBlock Text="{Binding BackendName}" Style="{StaticResource TextMuted}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Text="Emülatör exe" Style="{StaticResource TextCaption}"
                                                   Margin="0,12,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource TextBoxBase}"
                                                     Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Content="Gözat" Margin="8,0,0,0"
                                                    Style="{StaticResource ButtonSecondary}"
                                                    Command="{Binding DataContext.BrowseEmulatorCommand, ElementName=SettingsRoot}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <TextBlock Text="Argüman şablonu (varsayılanı kullanıcı değiştirebilir)"
                                                   Style="{StaticResource TextCaption}" Margin="0,12,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource TextBoxBase}" FontFamily="Consolas"
                                                     Text="{Binding ArgumentTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Content="Varsayılana sıfırla" Margin="8,0,0,0"
                                                    Style="{StaticResource ButtonGhost}"
                                                    Command="{Binding DataContext.ResetTemplateCommand, ElementName=SettingsRoot}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <CheckBox Content="Tam ekran (varsayılan)" Style="{StaticResource CheckBoxBase}"
                                                      IsChecked="{Binding DefaultFullscreen}" />
                                            <TextBlock Text="Ek argümanlar" Style="{StaticResource TextCaption}"
                                                       VerticalAlignment="Center" Margin="24,0,8,0" />
                                            <TextBox Width="220" Style="{StaticResource TextBoxBase}"
                                                     Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="BIOS / FIRMWARE YOLLARI (yalnızca yol kaydedilir, dosya sağlanmaz)"
                               Style="{StaticResource TextOverline}" Margin="0,12,0,8" />
                    <ItemsControl ItemsSource="{Binding BiosPaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BiosPathItem}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PlatformName}" Style="{StaticResource TextBodyStrong}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Style="{StaticResource TextBoxBase}"
                                             Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="Gözat" Margin="8,0,0,0"
                                            Style="{StaticResource ButtonSecondary}"
                                            Command="{Binding DataContext.BrowseBiosCommand, ElementName=SettingsRoot}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding LegalNote}" Style="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ================================================ görünüm -->
            <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="GÖRÜNÜM" Style="{StaticResource TextOverline}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Tema" Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                                   Width="160" />
                        <ComboBox Width="160" Style="{StaticResource ComboBoxBase}"
                                  ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                    </StackPanel>

                    <CheckBox Content="Başlatmadan önce onay iste" Style="{StaticResource CheckBoxBase}" Margin="0,12,0,0"
                              IsChecked="{Binding ConfirmBeforeLaunch}" />
                    <CheckBox Content="Başlatınca pencereyi küçült" Style="{StaticResource CheckBoxBase}" Margin="0,8,0,0"
                              IsChecked="{Binding MinimizeOnLaunch}" />
                    <CheckBox Content="Desteklenmeyen platformları göster (PS4/PS5)" Style="{StaticResource CheckBoxBase}"
                              Margin="0,8,0,0" IsChecked="{Binding ShowUnsupportedPlatforms}" />
                </StackPanel>
            </Border>

            <!-- ============================================== gelişmiş -->
            <Border Grid.Row="4" Style="{StaticResource Panel}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="GELİŞMİŞ" Style="{StaticResource TextOverline}" />

                    <TextBlock Text="Veritabanı" Style="{StaticResource TextCaption}" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource TextMuted}" />

                    <TextBlock Text="Metadata klasörü" Style="{StaticResource TextCaption}" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding MetadataPath}" Style="{StaticResource TextMuted}" />

                    <TextBlock Text="Ek tarama uzantıları (virgülle)" Style="{StaticResource TextCaption}"
                               Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding ExtraScanExtensions, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Kaydet" Style="{StaticResource ButtonPrimary}" Command="{Binding SaveCommand}" />
                        <Button Content="Veri klasörünü aç" Margin="12,0,0,0" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextCaption}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextCaption}"
                               Foreground="{DynamicResource Brush.Danger}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
