<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GameShelf.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameShelf.Application\GameShelf.Application.csproj" />
    <ProjectReference Include="..\..\src\GameShelf.Domain\GameShelf.Domain.csproj" />
    <ProjectReference Include="..\..\src\GameShelf.Infrastructure\GameShelf.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Test adlarindaki alt cizgi (CA1707), arayuz tipi kullanimi (CA1859) ve xUnit2013
         bu projede kasitlidir; log okunur kalsin diye kapatildi. -->
    <NoWarn>$(NoWarn);CA1707;CA1859;xUnit2013;xUnit1013</NoWarn>
  </PropertyGroup>
</Project>
